# ============================================================================
#  Order Saga — Configuração por ambiente (12-factor)
#  Copie este arquivo para `.env` e ajuste conforme o seu ambiente:
#      cp .env.example .env
#
#  IMPORTANTE — dois contextos de execução:
#   1) docker-compose  → usa a REDE INTERNA do compose (kafka:9092,
#      postgres:5432). O compose lê daqui apenas as credenciais, portas
#      mapeadas e o tuning (POSTGRES_*, SAGA_WORKERS, *PORT, ...).
#   2) `go run` no host → use as portas mapeadas no host
#      (KAFKA_BROKERS=localhost:9094, DATABASE_URL=...localhost:5433...),
#      conforme a seção "Execução no host".
# ============================================================================

# ----- Credenciais dos bancos (compose e aplicação) -------------------------
POSTGRES_USER=saga
POSTGRES_PASSWORD=saga
POSTGRES_DB=saga
POSTGRES_READ_DB=saga_read

# ----- Portas mapeadas no host (evite conflitos de porta locais) ------------
POSTGRES_PORT=5433
POSTGRES_READ_PORT=5434
KAFKA_PORT=9094
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
JAEGER_UI_PORT=16686

# ----- Execução no HOST (go run / testes / benchmark) -----------------------
# Valores literais de propósito: o `.env` também é usado via `source .env`,
# onde ${...} não é expandido pelo shell.
KAFKA_BROKERS=localhost:9094
DATABASE_URL=postgres://saga:saga@localhost:5433/saga?sslmode=disable
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ----- Tuning do pipeline (opcional — defaults sensatos) --------------------
# Concorrência intra-instância (1 = sequencial; réplicas escalam mais).
SAGA_WORKERS=1
# Commit de offsets do Kafka em lote.
KAFKA_COMMIT_BATCH=50
KAFKA_COMMIT_INTERVAL=200ms
# Tamanho do lote do outbox-relay.
OUTBOX_BATCH_SIZE=500
# Kafka cria tópicos automaticamente? Em produção: false (gerencie via IaC).
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
# Confirmação do produtor: "one" = máximo throughput (perde em failover de leader);
# "all" = durabilidade (default, recomendado em produção/replicado).
KAFKA_ACKS=all
# Amostragem de traces (spec OTel): parentbased_always_on (default),
# parentbased_traceidratio (use OTEL_TRACES_SAMPLER_ARG=0.1 p/ 10% em produção),
# always_off etc.
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1.0

